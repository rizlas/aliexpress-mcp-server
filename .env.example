# All optional — defaults shown
ALIEXPRESS_COUNTRY=IT
ALIEXPRESS_CURRENCY=EUR
ALIEXPRESS_LOCALE=it_IT
# Only needed for view_cart (login cookies from MCP Auth Bridge)
ALIEXPRESS_CREDENTIALS=~/.mcp-credentials/aliexpress.json
# Or read the session from Firefox: "auto" or a profile directory
# (overrides ALIEXPRESS_CREDENTIALS)
# ALIEXPRESS_FIREFOX_PROFILE=auto
